{
  "name": "cronheart",
  "version": "0.1.1",
  "description": "Cron job monitoring and dead man's switch for Node.js and TypeScript — heartbeat check-ins that alert you when a scheduled job stops running. Works with node-cron, croner, cron, node-schedule, BullMQ, NestJS schedule, plain crontab and systemd timers, plus a CLI wrapper for any command. Official SDK for cronheart.com.",
  "keywords": [
    "cron",
    "cron-monitoring",
    "cron-job",
    "crontab",
    "heartbeat",
    "dead-mans-switch",
    "deadmanssnitch",
    "job-monitoring",
    "monitoring",
    "scheduled-jobs",
    "uptime",
    "alerting",
    "observability",
    "node-cron",
    "croner",
    "node-schedule",
    "bullmq",
    "nestjs",
    "systemd-timer",
    "typescript",
    "cronitor",
    "healthchecks",
    "cronheart"
  ],
  "license": "MIT",
  "author": "Alexander Palazok",
  "homepage": "https://cronheart.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexander-po/cronheart-node.git"
  },
  "bugs": {
    "url": "https://github.com/alexander-po/cronheart-node/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "bin": {
    "cronheart": "dist/cli.mjs"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./api": {
      "import": {
        "types": "./dist/api.d.mts",
        "default": "./dist/api.mjs"
      },
      "require": {
        "types": "./dist/api.d.cts",
        "default": "./dist/api.cjs"
      }
    },
    "./sync": {
      "import": {
        "types": "./dist/sync.d.mts",
        "default": "./dist/sync.mjs"
      },
      "require": {
        "types": "./dist/sync.d.cts",
        "default": "./dist/sync.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.mts",
        "default": "./dist/testing.mjs"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./croner": {
      "import": {
        "types": "./dist/croner.d.mts",
        "default": "./dist/croner.mjs"
      },
      "require": {
        "types": "./dist/croner.d.cts",
        "default": "./dist/croner.cjs"
      }
    },
    "./cron": {
      "import": {
        "types": "./dist/cron.d.mts",
        "default": "./dist/cron.mjs"
      },
      "require": {
        "types": "./dist/cron.d.cts",
        "default": "./dist/cron.cjs"
      }
    },
    "./node-cron": {
      "import": {
        "types": "./dist/node-cron.d.mts",
        "default": "./dist/node-cron.mjs"
      },
      "require": {
        "types": "./dist/node-cron.d.cts",
        "default": "./dist/node-cron.cjs"
      }
    },
    "./node-schedule": {
      "import": {
        "types": "./dist/node-schedule.d.mts",
        "default": "./dist/node-schedule.mjs"
      },
      "require": {
        "types": "./dist/node-schedule.d.cts",
        "default": "./dist/node-schedule.cjs"
      }
    },
    "./bullmq": {
      "import": {
        "types": "./dist/bullmq.d.mts",
        "default": "./dist/bullmq.mjs"
      },
      "require": {
        "types": "./dist/bullmq.d.cts",
        "default": "./dist/bullmq.cjs"
      }
    },
    "./nestjs": {
      "import": {
        "types": "./dist/nestjs.d.mts",
        "default": "./dist/nestjs.mjs"
      },
      "require": {
        "types": "./dist/nestjs.d.cts",
        "default": "./dist/nestjs.cjs"
      }
    },
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "api",
    "sync",
    "testing",
    "croner",
    "cron",
    "node-cron",
    "node-schedule",
    "bullmq",
    "nestjs"
  ],
  "scripts": {
    "build": "tsdown && tsdown --config tsdown.api.config.ts && tsdown --config tsdown.cli.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:fixture": "tsc --project test/fixture-consumer",
    "publint": "publint --strict",
    "attw": "attw --pack . --exclude-entrypoints cli",
    "size": "node scripts/size-budget.mjs",
    "guard": "node scripts/source-guard.mjs src",
    "doc-claims": "node scripts/doc-claims.mjs",
    "private-information": "node scripts/private-information.mjs .",
    "release-metadata": "node scripts/release-metadata.mjs",
    "release-gate": "pnpm run doc-claims && pnpm run private-information && pnpm run release-metadata",
    "smoke": "node scripts/consumption-smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm run typecheck && pnpm run typecheck:fixture && pnpm run guard && pnpm run publint && pnpm run attw && pnpm run size",
    "check": "pnpm run build && pnpm run contract:check && pnpm run contract:drift && pnpm run contract:vectors && pnpm run lint && pnpm run doc-claims && pnpm run private-information && pnpm run test && pnpm run smoke",
    "audit": "pnpm audit --audit-level high",
    "contract:check": "node contract/check.mjs",
    "contract:drift": "node contract/drift.mjs",
    "contract:drift:live": "node contract/drift.mjs --live",
    "contract:vectors": "vitest run test/contract-vectors.test.ts test/contract-vectors-meta.test.ts test/contract-outcomes.test.ts test/contract-responses.test.ts",
    "fault-matrix": "vitest run test/fault-matrix.test.ts test/fault-matrix-meta.test.ts",
    "changeset": "changeset",
    "release:version": "changeset version",
    "min-peers": "node scripts/min-peers.mjs"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/schedule": "^4.0.0 || ^5.0.0 || ^6.0.0",
    "bullmq": "^5.0.0 || ^6.0.0",
    "cron": "^3.0.0 || ^4.0.0",
    "croner": "^9.0.0 || ^10.0.0",
    "node-cron": "^4.4.0",
    "node-schedule": "^2.1.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/schedule": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "cron": {
      "optional": true
    },
    "croner": {
      "optional": true
    },
    "node-cron": {
      "optional": true
    },
    "node-schedule": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.1",
    "@nestjs/common": "11.2.1",
    "@nestjs/core": "11.2.1",
    "@nestjs/schedule": "6.1.3",
    "@types/node": "22.20.1",
    "@types/node-schedule": "2.1.8",
    "bullmq": "6.1.2",
    "cron": "4.4.0",
    "croner": "10.0.1",
    "node-cron": "4.6.0",
    "node-schedule": "2.1.1",
    "publint": "0.3.24",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsdown": "0.22.14",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
